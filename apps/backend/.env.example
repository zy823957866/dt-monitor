# Application
NODE_ENV=development
PORT=3001

# MySQL control plane
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=dt_monitor
DB_TIMEZONE=+08:00
DB_CHARSET=utf8mb4
DB_SYNCHRONIZE=false

# 统一认证库（dt_frames，只读权限即可；注册脚本需要写 sys_app/sys_app_role）
AUTH_DB_TYPE=mysql
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=change-me
AUTH_DB_DATABASE=dt_frames
AUTH_DB_SYNCHRONIZE=false

# 统一认证服务内部地址
AUTH_SERVER_URL=http://localhost:3010/api
AUTH_SERVER_TIMEOUT=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=5000
REDIS_TTL=3600

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# 可选：与 auth-server 的 JWT_PUBLIC_KEY 保持一致；留空时从 AUTH_SERVER_URL/oauth/jwks 动态获取
JWT_PUBLIC_KEY=

# monitor OIDC 应用注册使用的前端基址
MONITOR_APP_BASE_URL=http://localhost:5179

# Browser SDK DSN used by snippets
MONITOR_DSN_ORIGIN=http://localhost:3001/api

# Browser origins allowed to call the data plane and control plane
CORS_ORIGINS=http://localhost:5173,http://localhost:5181,http://localhost:5182

# Local private storage for Replay chunks before S3/MinIO is enabled
REPLAY_STORAGE_DIR=./data/replays
