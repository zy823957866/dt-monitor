{
  "name": "@dt-monitor/sdk-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
					"types": "./src/index.tsx",
      "import": "./src/index.tsx"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
			"types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dt-monitor/sdk-browser": "workspace:*",
    "@dt-monitor/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
