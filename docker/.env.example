# 复制为 docker/.env 后再修改；该文件只放占位值，真实密钥不得提交。
COMPOSE_PROJECT_NAME=jianwei1
STACK_NETWORK=jianwei1-net

WEB_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

BACKEND_IMAGE=jianwei1-backend:local
WEB_IMAGE=jianwei1-web:local
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine

# 后端默认访问 Compose 内部 mysql/redis；切换外部服务时取消注释并修改。
# DB_HOST=mysql
# DB_PORT=3306
# REDIS_HOST=redis
# REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=change-me-root
DB_DATABASE=dt_monitor
DB_USERNAME=monitor
DB_PASSWORD=change-me-db-password

AUTH_DB_DATABASE=dt_frames
AUTH_DB_USERNAME=monitor
AUTH_DB_PASSWORD=change-me-db-password
# 认证库在同一个 mysql 容器时为 mysql；使用已有认证库时改为外部地址。
AUTH_DB_HOST=mysql
AUTH_DB_PORT=3306

# auth-server 内部地址（含 /api），默认从 Docker 宿主机的 3010 端口访问。
AUTH_SERVER_URL=http://host.docker.internal:3010/api
AUTH_SERVER_TIMEOUT=10000
# Nginx 代理 /auth-api 的 auth-server 根地址（不含 /api，结尾不加 /）。
AUTH_API_UPSTREAM=http://host.docker.internal:3010

# 浏览器公开地址：必须与 OIDC 回调、CORS、DSN 前缀一致，结尾不加 /。
PUBLIC_BASE_URL=https://monitor.example.com
VITE_SSO_URL=https://sso.example.com
VITE_OIDC_CLIENT_ID=monitor
VITE_APP_CODE=monitor
VITE_APP_ID=monitor
VITE_APP_ROUTER_BASE=/

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_PUBLIC_KEY=

CORS_ORIGINS=https://monitor.example.com
MONITOR_DSN_ORIGIN=https://monitor.example.com/api
